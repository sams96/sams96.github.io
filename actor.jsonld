            "object": {
              "id": "https://samsm.ch/subways/",
              "type": "Article",
              "name": "Subways",
              "summary": "\u003cp\u003eThis is the remnants of a failed attempt at a photo project looking at\nBirmingham\u0026rsquo;s pedestrian subways. I never really thought it was a very good idea\nfor a project but I decided to give it a go anyway because I wanted to try\nshooting a project and it was the best idea that I had, also the subways are the\nsort of thing that I usually like to shoot anyway.\u003c/p\u003e\n\n\n\n\u003cfigure\u003e\n\t\u003ca href=\"/photos/8405/\"\u003e\n\t\u003cimg src=\"/photos/8405/8405.avif\"\n         title=\"Subways 1\"\n         alt=\"TODO alt text\"\n\t\t height=\"999\"\n\t\t width=\"1000\"\n\t\t id=\"8405\" loading=\"lazy\"  fetchpriority=\"auto\" /\u003e \n    \u003c/a\u003e\u003cfigcaption\u003e\n            \u003cp\u003eSubways 1\u003c/p\u003e\n        \u003c/figcaption\u003e\n\t\u003c/figure\u003e",
              "url": "https://samsm.ch/subways/",
              "attributedTo": "https://samsm.ch/actor.jsonld",
              "to": "as:Public"
            }
          }]
    }
