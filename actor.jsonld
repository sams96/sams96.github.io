            "id": "https://samsm.ch/portfolio-ii/#create",
            "type": "Create",
            "summary": "Sam Smith created an article",
            "actor": "https://samsm.ch/actor.jsonld",
            "to": "as:Public",
            "published": "2018-11-25T00:00:00Z",
            "object": {
              "id": "https://samsm.ch/portfolio-ii/",
              "type": "Article",
              "name": "Portfolio II",
              "summary": "\u003cp\u003eThis set of images begins where the \u003ca href=\"/portfolio-i/\"\u003elast portfolio\u003c/a\u003e\nleaves off and primarily shows my travels during the summer of 2017, with the\nlast image being the only one outside of that. I have again chosen to stick to\nblack and white images taken with my Hasselblad for consistency, and because\nit\u0026rsquo;s what I primarily use. I am planning on doing one of these with the colour\nphotos that I\u0026rsquo;ve taken since I started shooting square format.\u003c/p\u003e",
              "url": "https://samsm.ch/portfolio-ii/",
              "attributedTo": "https://samsm.ch/actor.jsonld",
              "to": "as:Public"
            }
          },{
            "id": "https://samsm.ch/qingdao-diptych/#create",
            "type": "Create",
            "summary": "Sam Smith created an article",
            "actor": "https://samsm.ch/actor.jsonld",
